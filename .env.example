# Supabase (obligatorio para conectar con la base de datos)
# Crear proyecto en https://supabase.com → Settings → API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key

# Intervalo de actualización en milisegundos (default: 10000 = 10 segundos)
VITE_REFRESH_INTERVAL=10000

# Google Sheets CSV (legacy, se mantiene como fallback)
VITE_GOOGLE_SHEETS_CSV_URL=
